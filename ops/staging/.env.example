# Copy to ops/staging/.env (ignored). Use a dedicated test domain and fake accounts.
STAGING_HOST=staging.example.com
STAGING_USER=reader
# Generate interactively: docker run --rm -it caddy:2.11.2-alpine caddy hash-password
# Single quotes preserve bcrypt dollar signs in Compose dotenv files.
STAGING_PASSWORD_HASH=''
# openssl rand -hex 32 (hex is safe inside DATABASE_URL)
POSTGRES_PASSWORD=
# openssl rand -base64 32
AUTH_SECRET=
# A test SMTP provider supporting STARTTLS; no plaintext/Mailpit exception.
SMTP_ADDRESS=smtp.example.com:587
SMTP_FROM=login@example.com
SMTP_USERNAME=
SMTP_PASSWORD=
