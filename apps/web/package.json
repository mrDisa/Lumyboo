{
  "name": "@lumyboo/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node ../../scripts/check-pwa.mjs",
    "check": "tsc -b",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "generate:api": "openapi-typescript ../../contracts/openapi.yaml -o src/lib/api.generated.ts",
    "build:pages": "tsc -b && vite build --mode pages && node ../../scripts/check-pwa.mjs dist-pages && node ../../scripts/check-pages.mjs",
    "preview:pages": "vite preview --mode pages --host 127.0.0.1",
    "brand": "node ../../scripts/generate-brand.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "dexie": "4.4.7",
    "dexie-react-hooks": "4.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "fake-indexeddb": "6.2.8",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0"
  }
}
