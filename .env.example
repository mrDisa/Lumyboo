DATABASE_URL=postgres://lumyboo:local-development-only@127.0.0.1:5432/lumyboo?sslmode=disable
API_ADDRESS=127.0.0.1:8080

APP_ENV=development
PUBLIC_ORIGIN=http://127.0.0.1:5173
# Generate locally with: openssl rand -base64 32. Empty disables authentication.
AUTH_SECRET=
SMTP_ADDRESS=127.0.0.1:1025
SMTP_FROM=login@lumyboo.local
SMTP_ALLOW_INSECURE=true
SMTP_USERNAME=
SMTP_PASSWORD=
# Leave empty for direct requests. Configure exact reverse-proxy networks before deployment.
TRUSTED_PROXY_CIDRS=
